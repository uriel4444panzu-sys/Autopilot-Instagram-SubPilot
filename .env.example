# Copie ce fichier en ".env" pour des tests EN LOCAL uniquement.
# Ne jamais committer de vraie clé : ce fichier ne doit contenir que des
# exemples vides. En production (GitHub Action), ces valeurs viennent des
# secrets GitHub (Settings -> Secrets and variables -> Actions), jamais
# de ce fichier.

# ── Provider actif ──────────────────────────────────────────────────────
# "buffer" (par défaut, nouveau) ou "meta" (ancien, conservé pour rollback).
PUBLISHER=buffer

# ── Buffer (provider par défaut) ────────────────────────────────────────
# Clé API personnelle Buffer : compte Buffer -> Réglages -> API
# (ou https://publish.buffer.com/settings/api) -> onglet "Personal Access"
# -> "+ New Key". Voir BUFFER_SETUP.md pour le détail.
BUFFER_API_KEY=

# ID du channel Instagram SubPilot dans Buffer (récupéré via la fonction
# "Test Buffer Connection", qui liste les channels disponibles).
BUFFER_INSTAGRAM_CHANNEL_ID=

# Fuseau horaire par défaut utilisé pour programmer les posts quand
# calendar.json ne précise pas de "timezone" par post (IANA, ex: Europe/Paris).
BUFFER_DEFAULT_TIMEZONE=Europe/Paris

# Heure par défaut (HH:mm, dans BUFFER_DEFAULT_TIMEZONE) utilisée quand
# calendar.json ne précise pas de "time" par post.
BUFFER_DEFAULT_TIME=10:00

# ── Génération d'images (OpenAI, script scripts/generate-image.js) ─────
# Clé API OpenAI (platform.openai.com -> API keys). Utilisée uniquement
# par le workflow manuel "Generate Image (OpenAI)", indépendant de Buffer.
OPENAI_API_KEY=

# ── Meta / Instagram Graph API (legacy, utilisé seulement si PUBLISHER=meta) ──
# Voir README.md pour la procédure complète de création.
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── Publication (communs aux deux providers) ────────────────────────────
# URL publique de base pour les médias (feed/, stories/, videos/...).
# Fournie automatiquement par la GitHub Action ; à exporter manuellement
# seulement pour un test en local.
MEDIA_BASE=

# Publier seulement ce post (id de calendar.json). Vide = tous les posts dus.
ONLY_ID=

# "1" = simuler sans rien publier/programmer.
DRY_RUN=0
